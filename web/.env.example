# Base Postgres. En local : `docker compose up -d` démarre celle de docker-compose.yml.
DATABASE_URL=postgres://synego:synego@localhost:5432/synego
# Compte gérant initial : créé au premier accès à l’API.
ADMIN_EMAIL=
# Choisir un mot de passe unique d’au moins 12 caractères.
ADMIN_PASSWORD=
# URL publique du site, pour les liens canoniques.
NEXT_PUBLIC_SITE_URL=

# Agendas (facultatif, voir le README « Configurer Google Agenda »).
# Lien d’abonnement privé pour le gérant : jeton secret de 32 caractères minimum (openssl rand -hex 24).
CALENDAR_FEED_TOKEN=
# Synchronisation immédiate avec Google Agenda, au choix :
# 1. Compte Google de Youcef (OAuth, recommandé) : crée aussi un lien Google Meet pour chaque visio.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Agenda à utiliser : son identifiant, ou vide pour l’agenda principal du compte (OAuth uniquement).
GOOGLE_CALENDAR_ID=
# 2. Compte de service à qui l’agenda est partagé : pas de lien Meet (refusé par Google).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Adresse publique du site, reprise dans les événements (ex. https://synego.vercel.app).
SITE_URL=

# E-mails (API Resend) — voir le README « Configurer l’envoi d’e-mails ».
# Clé côté serveur uniquement : ne jamais l’exposer au navigateur ni la commiter.
# Le domaine de MAIL_FROM doit être vérifié dans Resend (Domains).
RESEND_API_KEY=
MAIL_FROM=noreply@abdu.fr
MAIL_FROM_NAME=Youcef · Synégo
# Facultatif : adresse de réponse (Reply-To), sur le même domaine que MAIL_FROM (ex. contact@abdu.fr),
# sinon ignorée. Vide : aucun Reply-To (un Reply-To vers un autre domaine ressemble à de l'hameçonnage).
MAIL_REPLY_TO=
# Facultatif : destinataire des notifications du gérant (par défaut, ADMIN_EMAIL).
MAIL_ADMIN_TO=

# Assistant IA « Une question ? » (OpenAI, gpt-6.1-terra) — voir le README « Configurer l’assistant IA ».
# Clé côté serveur uniquement : ne jamais l’exposer au navigateur ni la commiter. Vide : assistant désactivé.
OPENAI_API_KEY=
# Facultatif : modèle (gpt-6.1-terra par défaut) et effort de raisonnement (none, low par défaut, medium, high, xhigh, max).
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
# Facultatif : messages acceptés par jour pour tout le site, plafond de dépense (500 par défaut).
ASSISTANT_DAILY_LIMIT=

# Rappel e-mail la veille du rendez-vous (tâche planifiée /api/cron/rappels, voir vercel.json).
# Secret à générer avec `openssl rand -hex 24`. Une fois défini dans les variables du projet Vercel,
# Vercel l'envoie automatiquement aux tâches planifiées (Authorization: Bearer …). Vide : rappels désactivés.
CRON_SECRET=
